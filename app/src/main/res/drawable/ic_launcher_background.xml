<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep obsidian-indigo to twilight-teal diagonal gradient -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item
                    android:color="#FF0C1124"
                    android:offset="0.0" />
                <item
                    android:color="#FF172450"
                    android:offset="0.5" />
                <item
                    android:color="#FF102F4C"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft ambient indigo luminescence behind chip -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="44"
                android:gradientRadius="42"
                android:type="radial">
                <item
                    android:color="#575374FF"
                    android:offset="0.0" />
                <item
                    android:color="#1A2943A3"
                    android:offset="0.6" />
                <item
                    android:color="#000C1124"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Delicate mint-teal aura in lower-right -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="76"
                android:centerY="76"
                android:gradientRadius="36"
                android:type="radial">
                <item
                    android:color="#4756DBC6"
                    android:offset="0.0" />
                <item
                    android:color="#0056DBC6"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
